# Database Configuration
POSTGRES_DB=fitness_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Backend Spring Datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fitness_tracker
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080

# Set to "true" to require login to access the app
VITE_AUTH_ENABLED=false

# JWT
JWT_SECRET=fitness-tracker-secret-key-change-in-production-123456